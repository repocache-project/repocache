policy_module(repocache_ci_nginx, 1.0.0)

# Disposable native test policy, NOT an installed production module.
# Never grant permissions to httpd_t or relabel the distribution executable.
type repocache_ci_nginx_t;
type repocache_ci_nginx_exec_t;
init_daemon_domain(repocache_ci_nginx_t, repocache_ci_nginx_exec_t)
init_nnp_daemon_domain(repocache_ci_nginx_t)

type repocache_ci_nginx_ro_t;
files_type(repocache_ci_nginx_ro_t)
type repocache_ci_nginx_rw_t;
files_type(repocache_ci_nginx_rw_t)

allow repocache_ci_nginx_t self:process { signal_perms setrlimit };
allow repocache_ci_nginx_t self:tcp_socket create_stream_socket_perms;
allow repocache_ci_nginx_t self:unix_stream_socket create_stream_socket_perms;
allow repocache_ci_nginx_t self:fifo_file rw_fifo_file_perms;
read_files_pattern(repocache_ci_nginx_t, repocache_ci_nginx_ro_t, repocache_ci_nginx_ro_t)
allow repocache_ci_nginx_t repocache_ci_nginx_ro_t:dir list_dir_perms;
manage_dirs_pattern(repocache_ci_nginx_t, repocache_ci_nginx_rw_t, repocache_ci_nginx_rw_t)
manage_files_pattern(repocache_ci_nginx_t, repocache_ci_nginx_rw_t, repocache_ci_nginx_rw_t)
allow repocache_ci_nginx_t repocache_ci_nginx_rw_t:file map;

# Only the distribution HTTP port type; no permission on all port_type.
# Exact address/port enforcement is independent, in the private netns.
corenet_tcp_bind_generic_node(repocache_ci_nginx_t)
corenet_tcp_bind_http_port(repocache_ci_nginx_t)
corenet_tcp_connect_http_port(repocache_ci_nginx_t)
corenet_tcp_sendrecv_generic_if(repocache_ci_nginx_t)
corenet_tcp_sendrecv_generic_node(repocache_ci_nginx_t)
corenet_tcp_sendrecv_all_ports(repocache_ci_nginx_t)

files_search_var_lib(repocache_ci_nginx_t)
files_read_etc_files(repocache_ci_nginx_t)
libs_use_ld_so(repocache_ci_nginx_t)
libs_use_shared_libs(repocache_ci_nginx_t)
kernel_read_system_state(repocache_ci_nginx_t)
kernel_read_network_state(repocache_ci_nginx_t)
kernel_read_kernel_sysctls(repocache_ci_nginx_t)
dev_read_rand(repocache_ci_nginx_t)
dev_read_urand(repocache_ci_nginx_t)
dev_rw_null(repocache_ci_nginx_t)
auth_read_passwd(repocache_ci_nginx_t)
miscfiles_read_localization(repocache_ci_nginx_t)
