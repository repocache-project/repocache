policy_module(repocache_nginx, 1.0.0)

# Authenticated dedicated-domain candidate, not a production activation.
# The caller must independently verify exclusive namespace egress and WAL.
# Never grant permissions to httpd_t or relabel the distribution executable.
type repocache_nginx_t;
type repocache_nginx_exec_t;
init_daemon_domain(repocache_nginx_t, repocache_nginx_exec_t)
init_nnp_daemon_domain(repocache_nginx_t)

type repocache_nginx_ro_t;
files_type(repocache_nginx_ro_t)
type repocache_nginx_rw_t;
files_type(repocache_nginx_rw_t)

# Separate PID identity: systemd may read only the PID, not cache or TLS.
type repocache_nginx_pid_t;
files_pid_file(repocache_nginx_pid_t)
gen_require(`
    type init_t;
    type httpd_config_t;
    type httpd_cache_t;
    type httpd_log_t;
    type var_t;
    type var_log_t;
    type var_run_t;
    type cert_t;
')
allow init_t repocache_nginx_ro_t:dir search_dir_perms;
allow init_t repocache_nginx_pid_t:dir search_dir_perms;
allow init_t repocache_nginx_pid_t:file read_file_perms;
manage_files_pattern(repocache_nginx_t, repocache_nginx_pid_t, repocache_nginx_pid_t)
allow repocache_nginx_t repocache_nginx_pid_t:dir rw_dir_perms;

allow repocache_nginx_t self:process { signal_perms setrlimit };
# Dedicated root master: only the capabilities required to set up
# owned paths, drop worker credentials and signal workers. The nonroot
# unit still has an empty capability bounding set.
allow repocache_nginx_t self:capability { chown kill setgid setuid net_bind_service };

# Search only the native ancestor directories of the fixed owned paths.
# No read/write grant on vendor NGINX configuration, cache or logs.
allow repocache_nginx_t { httpd_config_t httpd_cache_t httpd_log_t var_t var_log_t var_run_t }:dir search_dir_perms;
# The native trust store is read-only; private keys use the owned ro type.
allow repocache_nginx_t cert_t:dir search_dir_perms;
allow repocache_nginx_t cert_t:file read_file_perms;
allow repocache_nginx_t cert_t:lnk_file { getattr read };

allow repocache_nginx_t self:tcp_socket create_stream_socket_perms;
allow repocache_nginx_t self:unix_stream_socket create_stream_socket_perms;
allow repocache_nginx_t self:fifo_file rw_fifo_file_perms;
read_files_pattern(repocache_nginx_t, repocache_nginx_ro_t, repocache_nginx_ro_t)
allow repocache_nginx_t repocache_nginx_ro_t:dir list_dir_perms;
manage_dirs_pattern(repocache_nginx_t, repocache_nginx_rw_t, repocache_nginx_rw_t)
manage_files_pattern(repocache_nginx_t, repocache_nginx_rw_t, repocache_nginx_rw_t)
allow repocache_nginx_t repocache_nginx_rw_t:file map;

# Only the distribution HTTP port type; no permission on all port_type.
# Exact address/port enforcement is independent, in the private netns.
corenet_tcp_bind_generic_node(repocache_nginx_t)
corenet_tcp_bind_http_port(repocache_nginx_t)
corenet_tcp_connect_http_port(repocache_nginx_t)
corenet_tcp_sendrecv_generic_if(repocache_nginx_t)
corenet_tcp_sendrecv_generic_node(repocache_nginx_t)
corenet_tcp_sendrecv_all_ports(repocache_nginx_t)

files_search_var_lib(repocache_nginx_t)
files_read_etc_files(repocache_nginx_t)
libs_use_ld_so(repocache_nginx_t)
libs_use_shared_libs(repocache_nginx_t)
kernel_read_system_state(repocache_nginx_t)
kernel_read_network_state(repocache_nginx_t)
kernel_read_kernel_sysctls(repocache_nginx_t)
dev_read_rand(repocache_nginx_t)
dev_read_urand(repocache_nginx_t)
dev_rw_null(repocache_nginx_t)
auth_read_passwd(repocache_nginx_t)
miscfiles_read_localization(repocache_nginx_t)
