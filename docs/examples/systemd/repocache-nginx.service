# REPOCACHE-owned native NGINX service; never override the vendor nginx.service.
# Installed only from the authenticated release, with a matching owned config.
[Unit]
Description=REPOCACHE isolated native NGINX service
After=network.target

[Service]
Type=forking
RuntimeDirectory=repocache-nginx
RuntimeDirectoryMode=0755
PIDFile=/run/repocache-nginx/nginx.pid
ExecStartPre=/usr/sbin/nginx -t -q -c /etc/nginx/repocache.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/repocache.conf
ExecReload=/usr/sbin/nginx -s reload -c /etc/nginx/repocache.conf
ExecStop=/usr/sbin/nginx -s quit -c /etc/nginx/repocache.conf
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/repocache-nginx /var/cache/nginx/repocache-managed /var/log/nginx/repocache-managed
UMask=0027

[Install]
WantedBy=multi-user.target
