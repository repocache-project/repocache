# NON-INSTALLED REFERENCE ONLY (#64). NOT a deployable service.
# The referenced fixed executable is deliberately not installed by this PR.
# An installed worker must be signed, root-owned and independently verified.
[Unit]
Description=REPOCACHE inert root-control worker (non-installed reference)
Requires=repocache-control.socket
After=repocache-control.socket
ConditionPathIsExecutable=/usr/libexec/repocache/server-control-worker

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/repocache/server-control-worker
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
TimeoutStartSec=10s
StandardInput=null
StandardOutput=journal
StandardError=journal
