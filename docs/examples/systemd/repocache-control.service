# NON-INSTALLED REFERENCE ONLY (#64). NOT a deployable service.
# The referenced fixed executable MUST be installed by an authenticated,
# separately reviewed release. The source-only entrypoint now exists in #31,
# but this example MUST NOT be enabled without signed install acceptance.
# An installed worker must be signed, root-owned and independently verified.
[Unit]
Description=REPOCACHE fixed native v2 transaction worker (non-installed reference)
Requires=repocache-control.socket
After=repocache-control.socket
ConditionPathIsExecutable=/usr/libexec/repocache/server-control-worker

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/repocache/server-control-worker
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/etc/nginx/conf.d /var/lib/repocache/server /var/lib/repocache/public /var/log/nginx /var/cache/nginx
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
TimeoutStartSec=240s
StandardInput=null
StandardOutput=journal
StandardError=journal
